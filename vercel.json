{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/label-hub",
      "destination": "/label-hub.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/smartlinks-admin",
      "destination": "/smartlinks-admin/index.html"
    },
    {
      "source": "/smartlinks-admin/(.*)",
      "destination": "/smartlinks-admin/index.html"
    },
    {
      "source": "/youtube",
      "destination": "/youtube/index.html"
    },
    {
      "source": "/youtube/(.*)",
      "destination": "/youtube/index.html"
    },
    {
      "source": "/tiktok",
      "destination": "/tiktok/index.html"
    },
    {
      "source": "/tiktok/(.*)",
      "destination": "/tiktok/index.html"
    },
    {
      "source": "/share",
      "destination": "/api/release"
    },
    {
      "source": "/share/",
      "destination": "/api/release"
    },
    {
      "source": "/share/(.*)",
      "destination": "/api/release"
    },
    {
      "source": "/transmit",
      "destination": "/api/release"
    },
    {
      "source": "/transmit/",
      "destination": "/api/release"
    },
    {
      "source": "/transmit/(.*)",
      "destination": "/api/release"
    },
    {
      "source": "/release",
      "destination": "/api/release"
    },
    {
      "source": "/release/",
      "destination": "/api/release"
    },
    {
      "source": "/release/(.*)",
      "destination": "/api/release"
    }
  ]
}
