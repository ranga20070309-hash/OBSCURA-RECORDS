{
  "rewrites": [
    {
      "source": "/transmit",
      "destination": "/transmit/index.html"
    },
    {
      "source": "/transmit/(.*)",
      "destination": "/transmit/index.html"
    },
    {
      "source": "/release",
      "destination": "/api/release.js"
    },
    {
      "source": "/release/(.*)",
      "destination": "/api/release.js"
    }
  ]
}
