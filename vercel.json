{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/admin-codes",
      "destination": "/submit/admin.html"
    },
    {
      "source": "/submit/admin",
      "destination": "/submit/admin.html"
    },
    {
      "source": "/dossier",
      "destination": "/submit/dossier.html"
    },
    {
      "source": "/submit/dossier",
      "destination": "/submit/dossier.html"
    },
    {
      "source": "/submit",
      "destination": "/submit/index.html"
    },
    {
      "source": "/submit/",
      "destination": "/submit/index.html"
    },
    {
      "source": "/label-hub",
      "destination": "/label-hub.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/unavailable",
      "destination": "/unavailable.html"
    },
    {
      "source": "/unavailable/(.*)",
      "destination": "/unavailable.html"
    },
    {
      "source": "/smartlinks-admin",
      "destination": "/smartlinks-admin/index.html"
    },
    {
      "source": "/smartlinks-admin/(.*)",
      "destination": "/smartlinks-admin/index.html"
    },
    {
      "source": "/youtube",
      "destination": "/youtube/index.html"
    },
    {
      "source": "/youtube/(.*)",
      "destination": "/youtube/index.html"
    },
    {
      "source": "/tiktok",
      "destination": "/tiktok/index.html"
    },
    {
      "source": "/tiktok/(.*)",
      "destination": "/tiktok/index.html"
    },
    {
      "source": "/share",
      "destination": "/api/release"
    },
    {
      "source": "/share/",
      "destination": "/api/release"
    },
    {
      "source": "/share/(.*)",
      "destination": "/api/release"
    },
    {
      "source": "/transmit",
      "destination": "/api/release"
    },
    {
      "source": "/transmit/",
      "destination": "/api/release"
    },
    {
      "source": "/transmit/(.*)",
      "destination": "/api/release"
    },
    {
      "source": "/release",
      "destination": "/api/release"
    },
    {
      "source": "/release/",
      "destination": "/api/release"
    },
    {
      "source": "/release/(.*)",
      "destination": "/api/release"
    }
  ]
}
