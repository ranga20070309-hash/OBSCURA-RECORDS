{
  "rewrites": [
    {
      "source": "/share",
      "destination": "/share/index.html"
    },
    {
      "source": "/share/(.*)",
      "destination": "/share/index.html"
    },
    {
      "source": "/transmit",
      "destination": "/share/index.html"
    },
    {
      "source": "/transmit/(.*)",
      "destination": "/share/index.html"
    },
    {
      "source": "/release",
      "destination": "/api/release.js"
    },
    {
      "source": "/release/(.*)",
      "destination": "/api/release.js"
    }
  ]
}

