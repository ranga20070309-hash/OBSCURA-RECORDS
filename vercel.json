{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/label-hub",
      "destination": "/label-hub.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/smartlinks-admin",
      "destination": "/smartlinks-admin/index.html"
    },
    {
      "source": "/smartlinks-admin/(.*)",
      "destination": "/smartlinks-admin/index.html"
    },
    {
      "source": "/share",
      "destination": "/api/release.js"
    },
    {
      "source": "/share/(.*)",
      "destination": "/api/release.js"
    },
    {
      "source": "/transmit",
      "destination": "/api/release.js"
    },
    {
      "source": "/transmit/(.*)",
      "destination": "/api/release.js"
    },
    {
      "source": "/release",
      "destination": "/api/release.js"
    },
    {
      "source": "/release/(.*)",
      "destination": "/api/release.js"
    }
  ]
}
